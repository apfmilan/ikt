# Trading Center deployment settings (non-secret). Copy to .env and edit.
# Secrets live in deploy/secrets/ (see deploy/secrets/README.md), never in this file.

# Public domain (DNS A/AAAA record must point to the VPS). Also the WebAuthn RP ID.
TC_DOMAIN=trading.example.com
# Contact for Let's Encrypt and the Web Push VAPID subject.
TC_ACME_EMAIL=you@example.com

# Images (built locally by `docker compose build`, or pulled from your registry).
TC_IMAGE=trading-center/server
TC_WEB_IMAGE=trading-center/web
TC_IMAGE_TAG=latest

# tracing filter
TC_LOG=info

# Live order sending in the engine process. Leave EMPTY until onboarding has verified the
# broker keys and you authorized live trading with your passkey. "enabled" arms the guard;
# the risk engine and live authorization still apply to every order.
TC_LIVE_TRADING=

# Backups (read by deploy/scripts/backup.sh via /etc/trading-center/backup.env or the shell)
TC_BACKUP_DIR=/var/backups/trading-center
TC_BACKUP_AGE_RECIPIENT_FILE=/etc/trading-center/backup-recipient.txt
TC_BACKUP_RETENTION_DAYS=14
